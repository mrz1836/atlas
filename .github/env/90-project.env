# ================================================================================================
# 🏗️ PROJECT CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for atlas
# Load Order: 90 (loaded after all defaults, overrides tool-specific settings)
#
# This file contains project-level configuration that overrides defaults from
# earlier env files (00-core, 10-*, 20-*). Use this for any settings that are
# specific to this repository.
#
# Maintainer: @mrz1836
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x
MAGE_X_GO_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE CONFIGURATION
# ================================================================================================

# Coverage Report Provider (overrides internal default to use codecov)
GO_COVERAGE_PROVIDER=codecov

# Codecov Configuration (only used when provider=codecov)
CODECOV_TOKEN_REQUIRED=true

# Coverage Exclusions (matches codecov.yml ignore paths)
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,test/,testing/,vendor/,testdata/

# ================================================================================================
# 🔧 MAGE-X CONFIGURATION
# ================================================================================================

# Exclude specific tags from auto-discovery (comma-separated)
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=go1,go1.18,windows,stress

# ================================================================================================
# 🛡️ CVE EXCLUSION OVERRIDES
# ================================================================================================

# Custom exclusions for AskNancy vulnerability scanning
# golang.org/x/crypto v0.51.0 CVEs (39827-39834,42508,46595,46597,46598): transitive-only via
# x/net, not imported by any atlas package (verified `go mod why`); no exploitable path.
NANCY_EXCLUDES=CVE-2026-34986,CVE-2026-39883,CVE-2026-39827,CVE-2026-39828,CVE-2026-39829,CVE-2026-39830,CVE-2026-39831,CVE-2026-39832,CVE-2026-39833,CVE-2026-39834,CVE-2026-42508,CVE-2026-46595,CVE-2026-46597,CVE-2026-46598,CVE-2026-41178

# Custom exclusions for Govulncheck/Magex vulnerability scanning
MAGE_X_CVE_EXCLUDES=CVE-2026-34986,CVE-2026-39883,CVE-2026-39827,CVE-2026-39828,CVE-2026-39829,CVE-2026-39830,CVE-2026-39831,CVE-2026-39832,CVE-2026-39833,CVE-2026-39834,CVE-2026-42508,CVE-2026-46595,CVE-2026-46597,CVE-2026-46598,CVE-2026-41178
